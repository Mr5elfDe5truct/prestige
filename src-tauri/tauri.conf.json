{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prestige",
  "version": "0.22.0",
  "identifier": "com.rgstudios.prestige",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prestige",
        "width": 1280,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#0a0707",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:* http://localhost:*; frame-src canvas: http://canvas.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "R.G. Studios",
    "copyright": "© 2026 Ryan B. Gyles",
    "category": "Productivity",
    "shortDescription": "Local AI chat by R.G. Studios",
    "longDescription": "Prestige by R.G. Studios, developed by Ryan B. Gyles. AI chat that runs entirely on this PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "windows/installer.nsi"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NkYyMjJDODREMjA1OTUKUldTVkJkS0VMQ0p2ZFpsYnpWbXJvbkQxRWhlazlKd0ZvSmJPa1lLZmdBTWZZZSt2TlNNZlB3YzYK",
      "endpoints": [
        "https://github.com/Mr5elfDe5truct/prestige/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
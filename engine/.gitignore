# Allowlist: ignore everything at the top level, then re-include only source, configs and docs.
/*
!/.gitignore
!/README.md
!/PLAN.md
!/LICENSE
!/*.ps1
!/scripts/
!/tools/
!/workflows/
!/requirements/
!/setup.cmd
!/theme/
!/docs/
!/.github/
!/bin/
/bin/*
!/bin/*.ini
!/bin/*.yaml

# Never commit these, wherever they appear
.webui_secret_key
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.log
.env
.env.*
*.key
*.pem
secrets*
__pycache__/
*.pyc
.venv/
node_modules/
